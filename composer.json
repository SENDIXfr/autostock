{
    "name": "prestashop/autostock",
    "description": "Automatically synchronizes PrestaShop product activation with available stock.",
    "type": "prestashop-module",
    "license": "AFL-3.0",
    "require": {
        "php": ">=7.2.5"
    },
    "autoload": {
        "psr-4": {
            "Autostock\\": "src/"
        },
        "classmap": [
            "autostock.php"
        ]
    },
    "scripts": {
        "test": [
            "@php tests/StockSynchronizerTest.php",
            "@php tests/ModuleTest.php",
            "@php tests/CronControllerTest.php"
        ],
        "test:integration": "@php tests/StockSynchronizerIntegrationTest.php"
    },
    "config": {
        "preferred-install": "dist",
        "prepend-autoloader": false,
        "sort-packages": true
    }
}
