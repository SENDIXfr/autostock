{
    "name": "prestashop/sdx-autostock",
    "description": "Automatically synchronizes PrestaShop product activation with available stock.",
    "type": "prestashop-module",
    "license": "AFL-3.0",
    "require": {
        "php": ">=7.2.5"
    },
    "autoload": {
        "psr-4": {
            "SDXAutostock\\": "src/"
        },
        "classmap": [
            "sdxautostock.php"
        ]
    },
    "scripts": {
        "test": "php tests/StockSynchronizerTest.php"
    },
    "config": {
        "preferred-install": "dist",
        "prepend-autoloader": false,
        "sort-packages": true
    }
}
